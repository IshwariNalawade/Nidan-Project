# Server-only secrets. Never prefix these with VITE_ and never commit .env.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/nidan

# Local patient/staff/doctor accounts use scrypt password hashing; no password secret is needed.
# Provision staff and doctors only through an authenticated admin account.

BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_ENDPOINT=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_ASR_SERVICE_ID=bhashini/ai4bharat/conformer-multilingual-asr
BHASHINI_OCR_SERVICE_ID=bhashini/bodhan/indic-doc/ocr
BHASHINI_TTS_SERVICE_ID=
BHASHINI_NMT_SERVICE_ID=
BHASHINI_TRANSLITERATION_SERVICE_ID=
BHASHINI_TLD_SERVICE_ID=
BHASHINI_ALD_SERVICE_ID=
BHASHINI_PUNCTUATION_SERVICE_ID=
BHASHINI_NORMALIZATION_SERVICE_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Required in production for platform/OAuth administration flows.
STAFF_ACCESS_CODE=

# Optional platform storage configuration is supplied by the runtime.

# Optional offline-first commands. Leave blank when the binaries are on PATH.
TESSERACT_BIN=
WHISPER_BIN=whisper
PIPER_BIN=piper
PIPER_MODEL=
